{
  "expo": {
    "name": "Saraiva.AI",
    "slug": "saraiva-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#075E54"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saraiva.ai"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#075E54"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.saraiva.ai"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://ultron-v2.osc-fr1.scalingo.io/api",
      "wsUrl": "wss://ultron-v2.osc-fr1.scalingo.io/ws"
    }
  }
}
